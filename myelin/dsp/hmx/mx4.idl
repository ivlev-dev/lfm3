#ifndef MX4_IDL
#define MX4_IDL
#include "AEEStdDef.idl"

interface mx4 {
   long init(in long vtcm_bytes);
   long load_buf(in long id, in sequence<octet> data);
   long gemm_i4(in long wid, in sequence<octet> act, in sequence<float> ascale,
                in long m, in long n, in long k, rout sequence<float> y);
   long gemm_i8(in long wid, in sequence<float> wscale, in sequence<octet> act,
                in sequence<float> ascale, in long m, in long n, in long k,
                rout sequence<float> y);
   long prefill(in long wid, in sequence<octet> act, in sequence<float> ascale,
                in long m, in long n, in long k, rout sequence<float> y);
   long reset();
};
#endif
