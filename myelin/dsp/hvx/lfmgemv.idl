#ifndef LFMGEMV_IDL
#define LFMGEMV_IDL

#include "AEEStdDef.idl"

interface lfmgemv {
   /* allocate a resident weight buffer on the DSP heap; returns handle in h */
   long alloc_buf(in long nbytes, rout long h);

   /* declare shape: N rows, K columns; with_scale != 0 allocates dequant tables */
   long set_shape(in long h, in long N, in long K, in long with_scale);

   /* copy a chunk of host-side data into the resident buffer at byte offset off */
   long load_buf(in long h, in long off, in sequence<octet> data);

   /* optional per-row fp32 weight scales, N floats */
   long set_scale(in long h, in sequence<octet> scales);

   /* M-row GEMV. act = M*K int8, dst = M*N int8. reps = internal repetitions.
      times[] = {min_cycles, max_cycles, avg_cycles, init_cycles,
                 qtimer_freq_hz, mac_count_lo, rows, threads} */
   long gemv(in long h, in long M, in sequence<octet> act,
             in long reps, rout sequence<octet> dst, rout sequence<long> times);

   /* micro-benchmarks: kind, arg(bytes/iterations) -> out[8] */
   long probe(in long h, in long kind, in long arg, rout sequence<long> res);

   /* one-RPC FFN layer: gate/up [N,K] int4, down [K,N] int4, SiLU fused */
   long ffn(in long hg, in long hu, in long hd, in sequence<octet> act,
            in long reps, rout sequence<octet> dst, rout sequence<octet> mid,
            rout sequence<long> times);

   /* map a host rpcmem/ION fd once; results then go straight into it */
   long attach_out(in long h, in long fd, in long nbytes);
   long detach_out(in long h);

   /* GEMV writing into the attached buffer (no per-call output transfer) */
   long gemv_resident(in long h, in long M, in sequence<octet> act,
                      in long reps, rout sequence<long> times);

   /* FFN writing its final int8 result straight into the attached buffer */
   long ffn_resident(in long hg, in long hu, in long hd, in sequence<octet> act,
                     in long reps, rout sequence<octet> mid, rout sequence<long> times);

   /* paged attention, M=1, GQA 16 q-heads / 4 kv-heads, head_dim 128.
      hk/hkt: K cache int4 [4][slots][64B] + per-token scales int32 [4][slots]
      hv    : V cache int2 [4][slots][32B], one scale per kv head (int32 [4])
      q     : int8 [16][128] (per-channel K scales already folded in by the host)
      tbl   : block table (page id per 32 tokens); window 0 = full
      out   : int32 [16][128] unnormalised accumulation; times[0..7] phase us */
   long attn(in long hk, in long hkt, in long hv, in long hvs,
             in sequence<octet> q, in sequence<long> tbl, in long pos, in long seq,
             in long window, in long reps, rout sequence<octet> outp,
             rout sequence<long> times);

   /* worker-team info: [0]=init rc, [1]=hvx reserve rc, [2]=hvx units,
      [3]=threads created, [4]=num cores */
   long team_info(rout sequence<long> res);

   long release_buf(in long h);

   /* zero-copy weight buffer: map a host rpcmem/ION fd as the resident
      weights of handle h (the "which" index), replacing the DSP heap copy
      made by alloc_buf.  nbytes is the mapped length; the first byte must be
      128 B aligned (rpcmem/ION pages are).  The host owns cache maintenance:
      flush the buffer before this call, or allocate it uncached.
      Existing resident calls (gemv/ffn/gemv_resident/ffn_resident) then read
      the weights straight out of DDR, with no heap copy and no per-call
      upload. */
   long attach_in(in long h, in long fd, in long nbytes);

   /* drop the mapping made by attach_in; the handle stays allocated but has
      no weights until it is attached again */
   long detach_in(in long h);

   /* create a weight handle that lives entirely in the host fd: no DSP heap
      weight allocation at all (use this for models larger than the DSP heap) */
   long alloc_in(in long fd, in long nbytes, rout long h);
};

#endif /* LFMGEMV_IDL */
