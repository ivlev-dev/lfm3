#ifndef LFMGEMV_IDL
#define LFMGEMV_IDL

#include "AEEStdDef.idl"

interface lfmgemv {
   long init(in sequence<octet> desc, in long arena_fd, in long arena_bytes, rout long h);

   long load_buf(in long h, in long tensor, in long off, in sequence<octet> data);

   long set_scale(in long h, in long tensor, in sequence<octet> scales);

   long exec(in long h, in sequence<octet> step, in sequence<octet> rows, in long logits_off,
             rout sequence<octet> info);

   long kv_commit(in long h, in long seq, in long layer, in long head, in long page,
                  in sequence<octet> krot, in sequence<octet> vrot);

   long kv_read(in long h, in long seq, in long layer, in long head, in long token,
                in long is_v, rout sequence<octet> outp);

   long reset_state(in long h, in long flags);

   long probe(in long h, in long kind, in long arg, rout sequence<long> res);
};

#endif
