#ifndef Q4K_IDL
#define Q4K_IDL

#include "AEEStdDef.idl"

/*
 * Q4_K GEMV contract for the HVX path (kernel: myelin/dsp/hvx/q4k_impl.c).
 *
 * This is the integration surface the orchestrator wires into
 * crates/myelin-core/src/backend/dsp.rs; it deliberately mirrors
 * myelin/dsp/hvx/lfmgemv.idl (alloc_buf / load_buf / set_shape / gemv /
 * release_buf) so the existing exec-command plumbing can host it.
 *
 * Weight buffer: the packed image of q4k_impl.h, N rows x K cols,
 * K % 256 == 0, row-major, 4.75 bit/weight:
 *   [0, N*blocks*24)         f32 d, f32 dmin, sc[8] u8, m[8] u8 per 256 weights
 *   [p_off, p_off+N*blocks*128)  128-B aligned nibble planes; p_off is
 *                                align128(N*blocks*24), see q4k_mat_init()
 * produced by q4k_pack_image() (bit-identical dequant to the GGUF blocks:
 * the only change is the nibble order inside a 256-weight block).
 *
 * Numerics (identical to the OpenCL reference, kernels/decode.cl:137-270):
 *   activations are int8 with one f32 scale per 32 channels
 *   (quantize_q8, decode.cl:78-121; on-device q4k_act_q8() is the same
 *   ties-to-even quantiser and is checked against the host bit for bit)
 *   y[n] = sum_b sum_g xs[b*8+g] * ( d_b*sc[b*8+g]*dot32(q, xq)
 *                                    - dmin_b*m[b*8+g]*sum32(xq) )
 *   dot32/sum32 are exact int32; the f32 combination happens per 32-group and
 *   never inside the accumulator.  Output is f32[N], no extra normalisation.
 *
 * args of gemv: f32 activations [K]; gemv_q8: int8 [K] + f32 [K/32].
 * dst: f32 [N] (little-endian).  times[]: {dsp_us, pcycles, rows, kernel_min}
 *   -- all four are only meaningful on the phone; under QEMU they are order of
 *   magnitude only.
 */
interface q4k {
   /* resident packed-Q4_K buffer; nbytes = q4k_image_bytes(N, K) */
   long alloc(in long nbytes, rout long h);
   /* upload a chunk of the packed image at byte offset off */
   long load(in long h, in long off, in sequence<octet> data);
   /* N rows, K columns (K % 256 == 0); must match the uploaded image */
   long set_shape(in long h, in long N, in long K);

   /* quantise act[K] (f32) into int8/32 on the DSP, then one GEMV */
   long gemv(in long h, in sequence<octet> act, in long reps,
             rout sequence<octet> dst, rout sequence<long> times);

   /* pre-quantised activations: xq[K] int8, xs[K/32] f32 */
   long gemv_q8(in long h, in sequence<octet> xq, in sequence<octet> xs,
                in long reps, rout sequence<octet> dst,
                rout sequence<long> times);

   long release_buf(in long h);
};

#endif /* Q4K_IDL */
